NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# App Auth & Public URL
AUTH_SECRET="your-secure-auth-secret-min-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

