generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BookPriceType {
  HARD_COPY
  SOFT_COPY
  FREE
  COMING_SOON
}

enum ModerationStatus {
  VISIBLE
  HIDDEN
}

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts        Post[]        @relation("PostAuthor")
  media        Media[]       @relation("MediaUploader")
  auditLogs    AuditLog[]    @relation("UserAuditLogs")
  postComments PostComment[] @relation("CommentAdminAuthor")
}

model Page {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  status         ContentStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  seoImageId     String?
  publishedAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sections PageSection[]
}

model PageSection {
  id        String        @id @default(cuid())
  pageId    String
  type      String
  title     String?
  content   Json
  settings  Json?
  sortOrder Int           @default(0)
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model Post {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  previousSlugs   String[]      @default([]) // Old slugs; public requests for these 301 to the current slug
  excerpt         String?
  body            String
  featuredImageId String?
  status          ContentStatus @default(DRAFT)
  seoTitle        String?
  seoDescription  String?
  authorId        String
  authorName      String?
  authorInitials  String?
  authorBio       String?
  categoryId      String?
  publishedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  author   User          @relation("PostAuthor", fields: [authorId], references: [id])
  category BlogCategory? @relation(fields: [categoryId], references: [id])
  comments PostComment[]
}

model BlogCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[]
}

model BookCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books Book[]
}

model Book {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  previousSlugs   String[]      @default([]) // Old slugs; public requests for these 301 to the current slug
  author          String        @default("Abimbola Lawuyi")
  description     String?
  rating          Float?        @default(5.0) // Manual fallback, used until the book has visible reviews
  reviewCount     Int           @default(0) // Denormalised: visible, non-deleted reviews
  averageRating   Float? // Denormalised: average of visible, non-deleted reviews
  publisher       String?
  publicationDate String?
  comingSoonDate  String?
  preOrderUrl     String?
  relatedBookIds  String[]      @default([])
  buyUrl          String?
  coverImageId    String?
  categoryId      String?
  status          ContentStatus @default(DRAFT)
  featuredOnHome  Boolean       @default(false)
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category BookCategory? @relation(fields: [categoryId], references: [id])
  prices   BookPrice[]
  reviews  BookReview[]
}

model BookReview {
  id            String           @id @default(cuid())
  bookId        String
  name          String
  email         String? // Optional, never shown publicly
  rating        Int // 1-5
  title         String?
  body          String
  status        ModerationStatus @default(VISIBLE)
  flagged       Boolean          @default(false) // Auto-held by the spam filter
  flagReason    String?
  authorReply   String? // Public reply from the author, written in the admin
  authorReplyAt DateTime?
  ipHash        String?
  userAgent     String?
  editTokenHash String? // SHA-256 of the private edit key held by the author's browser
  editedAt      DateTime?
  deletedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, status, deletedAt, createdAt])
  @@index([email, bookId])
  @@index([ipHash, createdAt])
  @@index([status, deletedAt, createdAt])
}

model PostComment {
  id            String           @id @default(cuid())
  postId        String
  parentId      String? // One level of threading: replies point at a top-level comment
  name          String
  email         String? // Optional, never shown publicly
  body          String
  isAuthor      Boolean          @default(false) // Posted by the site author from the admin
  adminUserId   String?
  status        ModerationStatus @default(VISIBLE)
  flagged       Boolean          @default(false)
  flagReason    String?
  ipHash        String?
  userAgent     String?
  editTokenHash String? // SHA-256 of the private edit key held by the author's browser
  editedAt      DateTime?
  deletedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("CommentReplies")
  adminUser User?         @relation("CommentAdminAuthor", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([postId, status, deletedAt, createdAt])
  @@index([parentId])
  @@index([ipHash, createdAt])
  @@index([status, deletedAt, createdAt])
}

model BookPrice {
  id        String        @id @default(cuid())
  bookId    String
  type      BookPriceType
  amount    Float?
  currency  String?       @default("NGN")
  url       String?
  available Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, type])
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    MessageStatus @default(UNREAD)
  createdAt DateTime      @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  firstName String
  email     String   @unique
  createdAt DateTime @default(now())
}

model SiteSettings {
  id             String   @id @default("singleton")
  authorName     String?
  authorInitials String?
  authorBio      String?
  contactEmail   String?
  contactPhone   String?
  address        String?
  instagramUrl   String?
  facebookUrl    String?
  whatsappUrl    String?
  telegramUrl    String?
  discordUrl     String?
  tiktokUrl      String?
  youtubeUrl     String?
  updatedAt      DateTime @updatedAt
}

model Media {
  id                 String   @id @default(cuid())
  cloudinaryPublicId String   @unique
  secureUrl          String
  width              Int?
  height             Int?
  altText            String?
  caption            String?
  uploadedById       String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  uploadedBy User @relation("MediaUploader", fields: [uploadedById], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User @relation("UserAuditLogs", fields: [userId], references: [id])
}

/// First-party, cookieless analytics. One row per pageview / custom event /
/// engagement ping. Written in batches (one insert per visit) by /api/collect.
model AnalyticsEvent {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime
  visitorId String // Monthly-rotating salted hash of IP + user agent (no raw IP stored)
  sessionId String // Random per-visit ID generated in the browser
  type      String // "pageview" | "event" | "engagement"
  name      String? // Custom event name (type = event)
  path      String
  referrer  String? // Referring domain or utm_source (first pageview of a visit)
  country   String? // ISO code from Vercel's geo header
  device    String? // desktop | mobile | tablet
  browser   String?
  os        String?
  duration  Int? // Seconds of active time on the page
  props     Json?

  @@index([createdAt])
  @@index([type, createdAt])
}
