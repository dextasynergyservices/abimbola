# Neon Postgres Database Connection String
DATABASE_URL="postgresql://neondb_owner:placeholder@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Cloudinary Credentials (Phase 7)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
