# Neon Postgres Database Connection String
DATABASE_URL="postgresql://neondb_owner:placeholder@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Cloudinary Credentials (Phase 7)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# App Auth & Public URL
AUTH_SECRET="your-secure-auth-secret-min-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# Google reCAPTCHA v3 (reviews & comments) — https://www.google.com/recaptcha/admin
# Choose "Score based (v3)" and add your domains (and localhost for dev).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
# Optional: minimum score 0.0–1.0 to accept a submission (default 0.5)
# RECAPTCHA_MIN_SCORE="0.5"

# Optional: email notifications for new reviews/comments via Resend (https://resend.com)
# RESEND_API_KEY=""
# NOTIFY_EMAIL_FROM="Abimbola Lawuyi <notifications@yourdomain.com>"
# NOTIFY_EMAIL_TO=""   # defaults to Site Settings -> contact email

# Analytics are first-party (stored in the database, batched once per visit).
# Recording only happens on the production deployment. To test locally:
# ANALYTICS_RECORD_ALL="true"
